<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div style="padding:20px;">
    <div class="card">
        <h2>Keys Management</h2>

        <!-- Filters -->
        <div style="margin-bottom:15px;">
            <select id="filterType" class="input">
                <option value="all">All</option>
                <option value="lifetime">Lifetime</option>
                <option value="weekly">Weekly</option>
            </select>
            <button class="btn" id="filterBtn">Filter</button>
            <button class="btn" id="exportCSV">Export CSV</button>
        </div>

        <!-- Keys Table -->
        <table class="table" id="keysTable">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Type</th>
                    <th>Redeemed</th>
                    <th>User</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="keysBody">
            </tbody>
        </table>
    </div>
</div>

<script>
async function fetchKeys(type="all"){
    const res = await fetch(`/keys?type=${type}`);
    const data = await res.json();
    const tbody = document.getElementById("keysBody");
    tbody.innerHTML = "";
    data.keys.forEach(k => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td>${k.key}</td>
            <td>${k.type}</td>
            <td>${k.redeemed ? "✅" : "❌"}</td>
            <td>${k.user || "-"}</td>
            <td>${new Date(k.createdAt).toLocaleString()}</td>
            <td>
                <button class="btn" onclick="deleteKey('${k.key}')">Delete</button>
            </td>
        `;
        tbody.appendChild(tr);
    });
}

async function deleteKey(key){
    if(!confirm(`Delete key ${key}?`)) return;
    const res = await fetch(`/keys/${key}`, { method:"DELETE" });
    const data = await res.json();
    alert(data.success ? "Deleted!" : data.error);
    fetchKeys(document.getElementById("filterType").value);
}

document.getElementById("filterBtn").addEventListener("click", () => {
    const type = document.getElementById("filterType").value;
    fetchKeys(type);
});

// Export CSV
document.getElementById("exportCSV").addEventListener("click", () => {
    const type = document.getElementById("filterType").value;
    window.location.href = `/keys-csv?key=${type}`;
});

// Initial load
fetchKeys();
</script>

<%- include("partials/footer") %>
