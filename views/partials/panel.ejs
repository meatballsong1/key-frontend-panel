<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div style="padding:20px;">
    <div class="card">
        <h2>Generate Keys</h2>
        <form id="generateForm">
            <input class="input" type="number" name="amount" placeholder="Amount" value="1" required>
            <select class="input" name="type">
                <option value="lifetime">Lifetime</option>
                <option value="weekly">Weekly</option>
            </select>
            <button class="btn" type="submit">Generate</button>
        </form>
        <pre id="generatedKeys" style="margin-top:15px;"></pre>
    </div>

    <div class="card">
        <h2>Auth Enabled: <%= authEnabled ? "✅" : "❌" %></h2>
    </div>
</div>

<script>
document.getElementById("generateForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    const formData = new FormData(e.target);
    const amount = formData.get("amount");
    const type = formData.get("type");
    const res = await fetch("/generate", {
        method:"POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({amount,type})
    });
    const data = await res.json();
    document.getElementById("generatedKeys").innerText = data.keysstring || JSON.stringify(data);
});
</script>
<%- include("partials/footer") %>

