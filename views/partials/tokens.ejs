<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div style="padding:20px;">
    <div class="card">
        <h2>Tokens Management</h2>

        <form id="addTokenForm" style="margin-bottom:15px;">
            <input class="input" name="token" placeholder="Token value" required>
            <select class="input" name="role">
                <option value="regular">Regular</option>
                <option value="admin">Admin</option>
            </select>
            <button class="btn" type="submit">Add Token</button>
        </form>

        <table class="table" id="tokensTable">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Role</th>
                    <th>Permissions</th>
                    <th>Notes</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="tokensBody"></tbody>
        </table>
    </div>
</div>

<script>
async function fetchTokens(){
    const res = await fetch("/tokens");
    const data = await res.json();
    const tbody = document.getElementById("tokensBody");
    tbody.innerHTML = "";
    data.tokens.forEach(t => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td>${t.token}</td>
            <td>${t.role}</td>
            <td>${JSON.stringify(t.permissions)}</td>
            <td>${t.notes || "-"}</td>
            <td>${new Date(t.createdAt).toLocaleString()}</td>
            <td>
                <button class="btn" onclick="deleteToken('${t._id}')">Delete</button>
            </td>
        `;
        tbody.appendChild(tr);
    });
}

document.getElementById("addTokenForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    const formData = new FormData(e.target);
    const token = formData.get("token");
    const role = formData.get("role");

    const res = await fetch("/tokens", {
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({ token, role })
    });

    const data = await res.json();
    alert(data.success ? "Token added!" : data.error);
    e.target.reset();
    fetchTokens();
});

async function deleteToken(id){
    if(!confirm("Delete this token?")) return;
    const res = await fetch(`/tokens/${id}`, { method:"DELETE" });
    const data = await res.json();
    alert(data.success ? "Deleted!" : data.error);
    fetchTokens();
}

// Load tokens initially
fetchTokens();
</script>

<%- include("partials/footer") %>
